# AWS Bedrock Configuration
# Default to ap-south-1 (Mumbai) where Amazon Nova models are active and available
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# Amazon Bedrock AgentCore Memory Resource ID
AGENTCORE_MEMORY_ID=your-agentcore-memory-id-here

# Search API (Tavily)
TAVILY_API_KEY=your-tavily-api-key-here

# Alternative models:
# BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0
# BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20240620-v1:0
